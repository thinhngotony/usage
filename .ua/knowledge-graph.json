  "layers": [
    {
      "id": "layer:application",
      "name": "Usage Dashboard Application",
      "description": "Implements the dependency-free CLI, concurrent Command Code API reads, quota and reset calculations, redacted export, and terminal dashboard rendering.",
      "nodeIds": [
        "file:usage.py"
      ]
    },
    {
      "id": "layer:test",
      "name": "Test Suite",
      "description": "Verifies key parsing, credential redaction, cost windows, authenticated API reads, quota calculations, reset sorting, and availability precedence.",
      "nodeIds": [
        "file:test_usage.py"
      ]
    },
    {
      "id": "layer:automation",
      "name": "Repository Automation",
      "description": "Runs the Python compile, test, and credential-safety CI matrix and configures monthly Dependabot updates for GitHub Actions.",
      "nodeIds": [
        "pipeline:.github/workflows/ci.yml",
        "config:.github/dependabot.yml"
      ]
    },
    {
      "id": "layer:documentation",
      "name": "Project Documentation",
      "description": "Explains dashboard setup and operation, architecture and scope, release history, contribution and security practices, and repository workflow preferences.",
      "nodeIds": [
        "document:ABOUT.md",
        "document:CHANGELOG.md",
        "document:CONTRIBUTING.md",
        "document:README.md",
        "document:SECURITY.md",
        "document:.commandcode/taste/taste.md"
      ]
    }
  ],
  "tour": [
    {
      "order": 1,
      "title": "Purpose and First Run",
      "description": "Start with README.md for the dashboard's purpose: local, dependency-free monitoring of multiple Command Code accounts without sending credentials elsewhere. Pair it with ABOUT.md to understand the deliberately read-only, standard-library scope before following the runtime path.",
      "nodeIds": [
        "document:README.md",
        "document:ABOUT.md"
      ]
    },
    {
      "order": 2,
      "title": "CLI Orchestration",
      "description": "usage.py is the broadest file-level node, and its main flow joins key parsing, concurrent account fetches, local state persistence, availability sorting, and terminal or export output. Read this orchestration first to see how the initial key import becomes the reusable local workflow introduced in Step 1.",
      "nodeIds": [
        "file:usage.py"
      ]
    },
    {
      "order": 3,
      "title": "Keys and Safe State",
      "description": "Within usage.py, key parsing accepts named JSON arrays, ordered JSON maps, or delimited keys and rejects malformed JSON-like input instead of silently downgrading it. This establishes the ordered account identities that the remaining pipeline consumes while keeping credentials confined to local state.",
      "nodeIds": [
        "file:usage.py"
      ]
    },
    {
      "order": 4,
      "title": "Concurrent API Collection",
      "description": "Building on validated accounts, fetch performs Bearer-authenticated requests for summary, credit-window, and subscription data, normalizes failures, and produces one Usage result. The graph makes fetch the main functional hub beneath the CLI flow, reflecting bounded standard-library concurrency across endpoints and accounts.",
      "nodeIds": [
        "file:usage.py"
      ],
      "languageLesson": "Python's concurrent.futures.ThreadPoolExecutor suits independent I/O-bound HTTP calls: bounded worker pools limit simultaneous requests while preserving a straightforward synchronous result model."
    },
    {
      "order": 5,
      "title": "Quota Availability Model",
      "description": "Each fetched response is normalized through alternate field names into a Usage dataclass, then rolling costs, bounded percentages, reset timestamps, and next-availability precedence are calculated. These decisions turn uneven API payloads into the stable account model consumed by sorting and presentation.",
      "nodeIds": [
        "file:usage.py"
      ]
    },
    {
      "order": 6,
      "title": "Dashboard and Redaction",
      "description": "With normalized Usage records in hand, usage.py renders ANSI-aware, terminal-width-adjusted tables and utilization bars or exports JSON and CSV. The export path deliberately removes raw keys, so presentation preserves account names and metrics without leaking credentials.",
      "nodeIds": [
        "file:usage.py"
      ]
    },
    {
      "order": 7,
      "title": "Behavioral Contract",
      "description": "test_usage.py imports usage.py and directly exercises the high-fan-in parsing, fetch, percentage, reset, availability, recent-cost, and export paths. Its local HTTP-server test verifies Bearer transport and all three API reads, while focused cases lock in fixed monthly quotas and credential redaction.",
      "nodeIds": [
        "file:test_usage.py"
      ]
    },
    {
      "order": 8,
      "title": "Security and Collaboration",
      "description": "After understanding runtime and tests, read SECURITY.md for the credential boundary: restrictive permissions, revocation, HTTPS Bearer transport, and redacted exports. CONTRIBUTING.md connects that boundary to the local compile and test workflow plus the project's dependency-free contribution expectations.",
      "nodeIds": [
        "document:SECURITY.md",
        "document:CONTRIBUTING.md"
      ]
    },
    {
      "order": 9,
      "title": "Automation and Maintenance",
      "description": "ci.yml carries the application and test contracts into Python 3.10 through 3.13 CI, including compilation and credential-shaped-string scanning on pushes and pull requests. dependabot.yml complements that pipeline with monthly GitHub Actions updates, closing the tour at repository maintenance.",
      "nodeIds": [
        "pipeline:.github/workflows/ci.yml",
        "config:.github/dependabot.yml"
      ],
      "languageLesson": "GitHub Actions YAML separates event triggers, jobs, and sequential steps; a version matrix repeats the same checks across supported Python releases."
    }
  ]
}
